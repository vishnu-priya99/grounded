# Copy to .env and adjust. Every value has a sensible default in src/grounded/config.py.

# ============================================================================
#  This ships configured for the Anthropic API. The follow-up brief allowed
#  paid keys, and it's the config the exam + 10-K were hardened on.
#  Add your key below and you're set. To run FULLY LOCAL instead (no key,
#  offline), see the "Local Ollama" block further down.
# ============================================================================

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ROUTER_MODEL=claude-haiku-4-5
# Fallback solve step only: chart reading, pattern puzzles, tricky MCQs, where
# model quality matters most. Empty = same as LLM_MODEL.
FALLBACK_MODEL=claude-sonnet-5
# How many times the fallback solves each item before taking the majority.
FALLBACK_VOTES=3

ANTHROPIC_API_KEY=
# billed per token, separate from any Claude.ai / Claude Code subscription.
# OpenAI works the same way: LLM_PROVIDER=openai, OPENAI_API_KEY=..., gpt-* models.

# Embeddings are always local (nomic-embed-text via Ollama) on every path.
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# ============================================================================
#  --- Local Ollama (no key, offline) ---   comment the block above, use this:
# ============================================================================
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# ROUTER_MODEL=qwen2.5:7b        # or qwen2.5:1.5b for a faster, weaker planner
# FALLBACK_MODEL=                # empty = same as LLM_MODEL
# VLM_MODEL=                     # moondream | qwen2.5vl:3b, image understanding
#                               # at ingest; empty = OCR only

# --- retrieval ---
TOP_K=8
ENABLE_RERANK=false
# Empty = embedded Qdrant (no extra process). Set to a standalone server
# (e.g. tools\qdrant\qdrant.exe) for the dashboard at <url>/dashboard and to
# avoid the embedded-mode single-process file lock.
QDRANT_URL=

# --- agents ---
CONFIDENCE_THRESHOLD=0.55
FAST_MODE=false

# --- ingest limits (all optional; defaults shown) ---
# MAX_FILE_MB=50
# MAX_PDF_PAGES=300
# MAX_TABLE_ROWS=100000
